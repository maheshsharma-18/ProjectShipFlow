// Prisma schema for ShipFlow AI

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  memberships Membership[]
  createdAt   DateTime @default(now())
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  memberships Membership[]
  projects    Project[]
  subscriptions BillingSubscription[]
  usageCredits UsageCredit[]
  githubInstallations GithubInstallation[]
  createdAt   DateTime @default(now())
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        String
  user        User      @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  @@unique([userId, workspaceId])
}

model Project {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  repositories Repository[]
  featureRequests FeatureRequest[]
  prds         PRD[]
  tasks        Task[]
  pullRequests PullRequest[]
  approvals    ReleaseApproval[]
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  createdAt    DateTime  @default(now())
}

model Repository {
  id           String   @id @default(cuid())
  projectId    String
  provider     String   // github
  externalId   String   // repo id
  name         String
  installationId String?
  project      Project  @relation(fields: [projectId], references: [id])
  createdAt    DateTime @default(now())
}

model FeatureRequest {
  id           String   @id @default(cuid())
  projectId    String
  title        String
  description  String
  status       String   @default("NEW")
  project      Project  @relation(fields: [projectId], references: [id])
  prd          PRD?
  createdAt    DateTime @default(now())
}

model PRD {
  id             String   @id @default(cuid())
  projectId      String
  featureRequestId String?
  content        String
  status         String   @default("DRAFT")
  project        Project  @relation(fields: [projectId], references: [id])
  featureRequest FeatureRequest? @relation(fields: [featureRequestId], references: [id])
  tasks          Task[]
  createdAt      DateTime @default(now())
}

model Task {
  id         String   @id @default(cuid())
  projectId  String
  prdId      String?
  title      String
  description String?
  status     String   @default("TODO") // TODO, IN_PROGRESS, DONE
  order      Int      @default(0)
  project    Project  @relation(fields: [projectId], references: [id])
  prd        PRD?     @relation(fields: [prdId], references: [id])
  createdAt  DateTime @default(now())
}

model PullRequest {
  id            String   @id @default(cuid())
  projectId     String
  repositoryId  String
  number        Int
  title         String
  state         String   // open, closed, merged
  headSha       String
  baseSha       String
  project       Project   @relation(fields: [projectId], references: [id])
  repository    Repository @relation(fields: [repositoryId], references: [id])
  reviews       Review[]
  createdAt     DateTime  @default(now())
  @@unique([repositoryId, number])
}

model Review {
  id           String   @id @default(cuid())
  pullRequestId String
  summary      String
  status       String   // PASSED, FAILED, NEEDS_CHANGES
  issues       ReviewIssue[]
  pullRequest  PullRequest @relation(fields: [pullRequestId], references: [id])
  createdAt    DateTime @default(now())
}

model ReviewIssue {
  id        String   @id @default(cuid())
  reviewId  String
  severity  String   // BLOCKING, NON_BLOCKING
  path      String?
  line      Int?
  message   String
  resolved  Boolean  @default(false)
  review    Review   @relation(fields: [reviewId], references: [id])
}

model WorkflowRun {
  id          String   @id @default(cuid())
  kind        String
  refId       String
  status      String
  createdAt   DateTime @default(now())
}

model BillingSubscription {
  id           String   @id @default(cuid())
  workspaceId  String
  plan         String   @default("FREE") // FREE, PRO
  status       String   @default("INACTIVE")
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  createdAt    DateTime @default(now())
}

model UsageCredit {
  id           String   @id @default(cuid())
  workspaceId  String
  kind         String
  amount       Int
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  createdAt    DateTime @default(now())
}

model GithubInstallation {
  id           String   @id @default(cuid())
  workspaceId  String
  installationId String @unique
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  createdAt    DateTime @default(now())
}

model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  externalId String   @unique
  event      String
  payload    Json
  createdAt  DateTime @default(now())
}

model ReleaseApproval {
  id          String   @id @default(cuid())
  projectId   String
  approvedBy  String?
  status      String   @default("PENDING")
  project     Project  @relation(fields: [projectId], references: [id])
  createdAt   DateTime @default(now())
}
