generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ShipmentStatus {
  PENDING
  PURCHASED
  IN_TRANSIT
  DELIVERED
  EXCEPTION
  CANCELLED
}

enum Carrier {
  SHIPPO
}

model User {
  id            String   @id @default(cuid())
  externalId    String   @unique
  email         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]
}

model Address {
  id        String   @id @default(cuid())
  name      String?
  line1     String
  line2     String?
  city      String
  state     String
  postal    String
  country   String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Parcel {
  id        String   @id @default(cuid())
  lengthCm  Float
  widthCm   Float
  heightCm  Float
  weightGr  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id               String   @id @default(cuid())
  userId           String
  toAddressId      String
  fromAddressId    String
  parcelId         String
  status           ShipmentStatus @default(PENDING)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  idempotencyKey   String?  @unique

  user        User     @relation(fields: [userId], references: [id])
  toAddress   Address  @relation("ToAddress", fields: [toAddressId], references: [id])
  fromAddress Address  @relation("FromAddress", fields: [fromAddressId], references: [id])
  parcel      Parcel   @relation(fields: [parcelId], references: [id])
  shipment    Shipment?
}

model Shipment {
  id              String   @id @default(cuid())
  orderId         String   @unique
  carrier         Carrier
  status          ShipmentStatus @default(PENDING)
  trackingNumber  String? 
  labelUrl        String?
  purchasedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  idempotencyKey  String?  @unique

  order           Order    @relation(fields: [orderId], references: [id])
  trackingEvents  TrackingEvent[]
}

model TrackingEvent {
  id             String   @id @default(cuid())
  shipmentId     String
  carrier        Carrier
  trackingNumber String
  eventId        String
  status         ShipmentStatus
  description    String?
  location       String?
  occurredAt     DateTime
  createdAt      DateTime @default(now())

  shipment       Shipment @relation(fields: [shipmentId], references: [id])

  @@unique([carrier, trackingNumber, eventId])
}

model WebhookEvent {
  id         String   @id @default(cuid())
  source     String
  eventId    String
  payload    Json
  receivedAt DateTime @default(now())

  @@unique([source, eventId])
}
