{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@shipflow/db": ["packages/db/src"],
      "@shipflow/shared": ["packages/shared/src"],
      "@shipflow/ai": ["packages/ai/src"],
      "@shipflow/integrations": ["packages/integrations"]
    }
  }
}
