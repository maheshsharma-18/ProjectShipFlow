    "lint": "echo 'no lint'",
    "test": "jest -c jest.config.js --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "11.1.27",
    "@nestjs/core": "11.1.27",
    "@nestjs/platform-express": "11.1.27",
    "@nestjs/config": "4.0.4",
    "@nestjs/swagger": "11.4.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "bullmq": "5.79.2",
    "ioredis": "5.11.1",
    "jwks-rsa": "4.1.0",
    "jsonwebtoken": "9.0.3",
    "swagger-ui-express": "5.0.1",
    "@shipflow/db": "workspace:*",
    "@shipflow/shared": "workspace:*",
    "@shipflow/ai": "workspace:*",
    "@shipflow/integrations": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "26.0.1",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "@types/jest": "29.5.12"
